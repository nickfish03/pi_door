# Chicken coop door controller - systemd unit.
# Installed by install.sh, which fills in @USER@ and @REPO@. Don't edit
# the copy in /etc/systemd/system; edit this file and re-run install.sh.

[Unit]
Description=Chicken coop door controller (web UI + scheduler)
# Don't wait for the network: the scheduler and relay safety must run even
# if WiFi never comes up. The web server binds 0.0.0.0, so it starts
# answering on its own once WiFi connects.
After=time-sync.target

[Service]
Type=simple
User=@USER@
Group=@USER@
# gpio group = access to /dev/gpiomem without root.
SupplementaryGroups=gpio
WorkingDirectory=@REPO@
Environment=PYTHONUNBUFFERED=1
Environment=COOPDOOR_STATE_DIR=/var/lib/coopdoor

# Relays off before starting, and again after stopping for ANY reason -
# including a crash or kill, where the program's own cleanup never runs.
# A GPIO pin otherwise keeps its last level after its process dies.
ExecStartPre=/usr/bin/python3 -m coopdoor.relays_off
ExecStart=/usr/bin/python3 -m coopdoor
ExecStopPost=/usr/bin/python3 -m coopdoor.relays_off

Restart=always
RestartSec=5

# Settings live in /var/lib/coopdoor/settings.json, created and owned for
# @USER@ by systemd.
StateDirectory=coopdoor

# Port 80 without running as root: grant only the one capability needed.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
